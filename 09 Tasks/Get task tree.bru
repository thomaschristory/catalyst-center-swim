meta {
  name: Get task tree
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/dna/intent/api/v1/task/{{taskId}}/tree
  body: none
  auth: inherit
}

script:post-response {
  const tasks = (res.getBody() || {}).response || [];
  for (const t of tasks) {
    const state = t.endTime ? (t.isError ? "FAILED" : "DONE") : "RUNNING";
    console.log(`${state.padEnd(8)} ${t.id} ${t.progress || ""}` + (t.failureReason ? ` | ${t.failureReason}` : ""));
  }
}

tests {
  const tasks = res.getBody().response || [];
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("no subtask in error", function () {
    expect(tasks.filter(t => t.isError).length).to.equal(0);
  });
}

docs {
  Parent task plus per-device subtasks. A batch can report the parent as fine while one device failed,
  so check here. The console tab lists each subtask with its state.
}
