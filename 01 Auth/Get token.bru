meta {
  name: Get token
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/dna/system/api/v1/auth/token
  body: none
  auth: basic
}

auth:basic {
  username: {{username}}
  password: {{password}}
}

script:post-response {
  const body = res.getBody();
  if (body && body.Token) {
    bru.setVar("token", body.Token);
  }
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("token returned", function () {
    expect(res.getBody().Token).to.be.a("string");
  });
}

docs {
  Basic auth against the system API. Stores the token in the runtime variable `token`.
  Tokens last about 60 minutes; re-run when you start getting 401s.
}
